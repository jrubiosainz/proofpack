# Optional operator-only Azure execution. Never needed for start, demo, build or test.
# Export these in your shell; ProofPack does not automatically read .env files.
PROOFPACK_ALLOW_AZURE=1
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_TENANT_ID=<your-tenant-id>
AZURE_RESOURCE_GROUP=rg-proofpack
AZURE_ACCOUNT_NAME=<your-azure-openai-account>
AZURE_DEPLOYMENT_NAME=<your-structured-output-deployment>
FOUNDRY_ENDPOINT=https://<your-account>.openai.azure.com
